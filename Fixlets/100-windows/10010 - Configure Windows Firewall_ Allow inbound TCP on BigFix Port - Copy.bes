<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Task>
		<Title>Configure Windows Firewall: Allow inbound TCP on BigFix Port</Title>
		<Description><![CDATA[Adds BigFix&nbsp;Relay port to Windows Firewall ]]></Description>
		<Relevance>windows of operating system</Relevance>
		<Relevance>if exists property "in proxy agent context" then not in proxy agent context else true</Relevance>
		<Relevance><![CDATA[version of operating system >= "6" as version]]></Relevance>
		<Relevance><![CDATA[exists (values "EnableFirewall" of keys ("HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\WindowsFirewall\" & current profile type of firewall as string & "Profile") of native registry as string ) whose (it="1") or  ( firewall enabled of current profile of local policy of firewall AND not exists (value "EnableFirewall" of key ("HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\WindowsFirewall\" & current profile type of firewall as string & "Profile") of native registry as string | "-1") whose (it = "0") )]]></Relevance>
		<Relevance>not exists globally open port whose (port of it as string = (value "ListenPort" of key "HKLM\SOFTWARE\BigFix\EnterpriseClient\GlobalOptions" of registry as string) AND protocol of it = tcp AND enabled of it) of current profile of local policy of firewall</Relevance>
		<Category></Category>
		<Source>Internal</Source>
		<SourceID></SourceID>
		<SourceReleaseDate>2014-04-08</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-bfsync-source-actionsite</Name>
			<Value>http://BES-Dev-Root:52311/cgi-bin/bfgather.exe/actionsite</Value>
		</MIMEField>
		<MIMEField>
			<Name>x-bfsync-source-sitetype</Name>
			<Value></Value>
		</MIMEField>
		<MIMEField>
			<Name>x-bfsync-source-sitename</Name>
			<Value>ActionSite</Value>
		</MIMEField>
		<MIMEField>
			<Name>x-bfsync-source-modification-time</Name>
			<Value>Thu, 12 Jan 2023 19:36:59 +0000</Value>
		</MIMEField>
		<MIMEField>
			<Name>x-bfsync-source-id</Name>
			<Value>271</Value>
		</MIMEField>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Tue, 17 Jan 2023 01:23:12 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<DefaultAction ID="Action1">
			<Description>
				<PreLink>Click </PreLink>
				<Link>here</Link>
				<PostLink> to deploy this action.</PostLink>
			</Description>
			<ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
action uses wow64 redirection false

parameter "RuleName"="BigFix Client TCP"
parameter "LocalPort"="{ (value "ListenPort" of key "HKLM\SOFTWARE\BigFix\EnterpriseClient\GlobalOptions" of registry as string)}"
parameter "Protocol"="tcp"
parameter "Description"="BigFix Client Inbound TCP"



delete "__appendfile"
appendfile netsh.exe advfirewall firewall add rule name="{parameter "RuleName" of action as string}" dir=in action=allow localport={parameter "LocalPort" of action as string} protocol={parameter "Protocol" of action as string} description="{parameter "Description" of action as string}" profile=any

delete "addrule.cmd"
move "__appendfile" "addrule.cmd"
waithidden cmd /c addrule.cmd
</ActionScript>
		</DefaultAction>
	</Task>
</BES>
